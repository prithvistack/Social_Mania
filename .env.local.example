# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Create an "OAuth client ID" of type "Web application".
# Authorized redirect URI (local):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (Vercel): https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Random 32-byte secret used to encrypt the session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required on Vercel; leave unset locally.
# AUTH_URL=https://<your-app>.vercel.app

# --- Access control (single-user app) ---
# Only this Google account may sign in. Anyone else is rejected.
ALLOWED_EMAIL=you@gmail.com

# --- Feed tuning ---
# Cache lifetime in seconds before the feed is refetched. Default 1 hour.
FEED_TTL_SECONDS=3600

# --- Supabase (required) ---
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL
# editor, then copy these from Project Settings -> API.
# The service role key bypasses row-level security: server-side only, never
# NEXT_PUBLIC_, never imported from a client component.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Quota ---
# Daily YouTube API unit budget. Google's hard cap is 10000; leaving headroom
# means a surprise never breaks the feed outright.
YT_DAILY_BUDGET=8000

# --- Learning assistant (optional) ---
# https://aistudio.google.com/apikey — server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
